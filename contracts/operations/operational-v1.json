  "scenarios": {
    "idempotency": [
      {
        "id": "SI-01",
        "name": "same key + same request while the original is running",
        "existing": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1",
          "state": "IN_PROGRESS",
          "lease_live": true
        },
        "request": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1"
        },
        "expected": "IDEMPOTENCY_IN_PROGRESS"
      },
      {
        "id": "SI-02",
        "name": "same key + same request after completion",
        "existing": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1",
          "state": "COMPLETED",
          "lease_live": false
        },
        "request": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1"
        },
        "expected": "RETURN_ORIGINAL_OUTCOME_WITHOUT_EXECUTION"
      },
      {
        "id": "SI-03",
        "name": "same key + different request",
        "existing": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1",
          "state": "COMPLETED",
          "lease_live": false
        },
        "request": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D2"
        },
        "expected": "IDEMPOTENCY_KEY_REUSED"
      },
      {
        "id": "SI-04",
        "name": "same key + same request by a different principal",
        "existing": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1",
          "state": "COMPLETED",
          "lease_live": false
        },
        "request": {
          "principal": "P2",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1"
        },
        "expected": "EXECUTE"
      },
      {
        "id": "SI-05",
        "name": "same key + same principal, different operation",
        "existing": {
          "principal": "P1",
          "operation": "createCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1",
          "state": "COMPLETED",
          "lease_live": false
        },
        "request": {
          "principal": "P1",
          "operation": "closeCase",
          "target": "/api/v1/cases",
          "key": "K1",
          "digest": "D1"
        },
        "expected": "EXECUTE"
      },
      {
        "id": "SI-06",
        "name": "same key + same principal and operation, different target resource",
        "existing": {
          "principal": "P1",
          "operation": "closeCase",
          "target": "/api/v1/cases/C1/close",
          "key": "K1",
          "digest": "D1",
          "state": "COMPLETED",
          "lease_live": false
        },
        "request": {
          "principal": "P1",
          "operation": "closeCase",
          "target": "/api/v1/cases/C2/close",
          "key": "K1",
          "digest": "D1"
        },
        "expected": "EXECUTE"
      },
      {
