{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trustlens:contracts:phase6:phase6-closure-contract:1.0.0",
  "title": "TrustLens Phase-6 closure manifest",
  "description": "Structural schema for contracts/phase6/phase6-closure-v1.json. Semantic and cross-contract rules are enforced by knowledge/validation/validate_phase6_closure.py. Local definitions only; no external references.",
  "$defs": {
    "relpath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!\\.git/)[A-Za-z0-9._/-]+$"
    },
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "work_package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P6-WP[1-6]$"
        },
        "gate_id": {
          "type": "string",
          "pattern": "^GATE-0(19|2[0-4])$"
        },
        "gate_path": {
          "$ref": "#/$defs/relpath"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "merge_commit": {
          "$ref": "#/$defs/hex40"
        },
        "pr_head_commit": {
          "$ref": "#/$defs/hex40"
        },
        "primary_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relpath"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "independent_review": {
          "type": "string",
          "minLength": 1
        },
        "remote_ci": {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "conclusion": {
              "type": "string",
              "minLength": 1
            },
            "pr_head_run_id": {
              "type": "integer",
              "minimum": 1
            },
            "merge_commit_run_id": {
              "type": "integer",
              "minimum": 1
            },
            "evidence_source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "workflow",
            "checks",
            "conclusion",
            "pr_head_run_id",
            "merge_commit_run_id",
            "evidence_source"
          ],
          "additionalProperties": false
        },
        "merged": {
          "type": "boolean"
        },
        "closure_state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "gate_id",
        "gate_path",
        "pr_number",
        "merge_commit",
        "pr_head_commit",
        "primary_artifacts",
        "independent_review",
        "remote_ci",
        "merged",
        "closure_state"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relpath"
