    {"id": "NEG-08", "expect": "DC-14", "description": "tenant column added while ASM-002 is unconfirmed",
     "op": "append", "path": ["tables", {"name": "case_record"}, "columns"],
     "value": {"name": "tenant_id", "type": "uuid", "nullable": true, "classification": "C2", "description": "tenant"}},
    {"id": "NEG-09", "expect": "DC-17", "description": "invented retention duration",
     "op": "append", "path": ["tables", {"name": "retention_policy_reference"}, "columns"],
     "value": {"name": "retention_days", "type": "integer", "nullable": true, "classification": "C2", "description": "days"}},
    {"id": "NEG-10", "expect": "DC-08", "description": "result loses its ENGINE_VERSION pin",
