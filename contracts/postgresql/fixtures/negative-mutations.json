{
  "description": "Negative fixtures for knowledge/validation/validate_data_contract.py. Each mutation is applied to an in-memory copy of contracts/postgresql/schema-v1.json; the named check MUST reject it. Path segments are object keys, list indexes, or {\"name\": ...}/{\"id\": ...} selectors.",
  "mutations": [
    {"id": "NEG-01", "expect": "DC-09", "description": "two evaluations could share one governed input artifact",
     "op": "remove", "path": ["tables", {"name": "governed_input_artifact"}, "unique", {"name": "uq_governed_input_artifact_evaluation"}]},
    {"id": "NEG-02", "expect": "DC-07", "description": "raw submitted text stored inline on the evidence manifest",
     "op": "append", "path": ["tables", {"name": "evidence_item"}, "columns"],
     "value": {"name": "raw_text", "type": "text", "nullable": true, "classification": "C3", "description": "raw message"}},
    {"id": "NEG-03", "expect": "DC-04", "description": "cascade delete from case to submissions",
     "op": "set", "path": ["tables", {"name": "submission"}, "foreign_keys", 0, "on_delete"], "value": "CASCADE"},
    {"id": "NEG-04", "expect": "DC-12", "description": "numeric scam score column on the result",
     "op": "append", "path": ["tables", {"name": "detection_result"}, "columns"],
     "value": {"name": "scam_score", "type": "integer", "nullable": true, "classification": "C2", "description": "0-100 score"}},
    {"id": "NEG-05", "expect": "DC-10", "description": "provider API key stored as an ordinary column",
     "op": "append", "path": ["tables", {"name": "external_enrichment_result"}, "columns"],
