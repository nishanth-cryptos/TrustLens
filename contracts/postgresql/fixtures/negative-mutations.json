               "store_class": "OPS", "authority": "OPERATIONAL_RECORD", "classification": "C1", "mutability": "M-OPS",
               "delete_policy": "NEVER", "retention": {"mode": "NOT_APPLICABLE"},
               "columns": [{"name": "rule_definition_id", "type": "uuid", "nullable": false, "classification": "C2", "description": "identifier"},
                           {"name": "rule_logic", "type": "jsonb", "nullable": false, "classification": "C1", "description": "rule logic",
                            "jsonb_contract": {"contract": "rule.schema.json", "version_source": "x", "immutability": "IMMUTABLE_ONCE_WRITTEN", "validation_owner": "x"}}],
               "primary_key": ["rule_definition_id"], "foreign_keys": [], "unique": [], "checks": [], "indexes": [],
