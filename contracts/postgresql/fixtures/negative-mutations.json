    {"id": "NEG-25", "expect": "DC-25", "description": "MEDIUM-1: failed evaluation keeps a live fence token",
     "op": "remove", "path": ["tables", {"name": "evaluation"}, "checks", {"name": "ck_evaluation_fence_cleared_when_failed"}]},
    {"id": "NEG-26", "expect": "DC-25", "description": "MEDIUM-1: fence token update cascades into the result row",
     "op": "set", "path": ["tables", {"name": "detection_result"}, "foreign_keys", 3, "on_update"], "value": "CASCADE"},
    {"id": "NEG-27", "expect": "DC-25", "description": "MEDIUM-1: result fence token nullable (stale worker could write unfenced)",
     "op": "set", "path": ["tables", {"name": "detection_result"}, "columns", {"name": "execution_fence_token"}, "nullable"], "value": true},
    {"id": "NEG-28", "expect": "DC-25", "description": "MEDIUM-1: deferred result => COMPLETED commit invariant removed",
     "op": "remove", "path": ["tables", {"name": "detection_result"}, "constraint_triggers", {"name": "tg_detection_result_requires_completed"}]}
  ]
