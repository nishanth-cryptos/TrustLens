        "external_enrichment_result_id",
        "evaluation_id",
        "provider_ref",
        "adapter_version",
        "integration_contract_version",
        "request_ref",
        "requested_at",
        "responded_at",
        "status",
        "safe_error_category",
        "reputation_result",
        "allowlist_result",
        "domain_matches_claimed_brand",
        "raw_provider_content_policy_ref",
        "consumed_in_governed_artifact"
      ],
      "notes": "Logical result maps onto the accepted WP2 row; INT-001 does not duplicate the persistence schema. Additional provenance columns are additive WP2 requirements (persistence_additive_requirements)."
    },
    {
      "name": "ExternalProviderIdentity",
      "store": "OPS",
      "fields": [
        "provider_ref",
        "provider_category",
        "authentication_method_ref"
      ],
      "notes": "Opaque identity; no vendor is named by INT-001."
    },
    {
      "name": "ExternalProviderPolicy",
      "store": "GOVERNED_CONFIGURATION",
      "fields": [
        "provider_policy_ref",
        "provider_policy_version",
        "provider_ref",
        "provider_operation",
        "scheme",
        "host",
        "host_match",
        "port",
        "path_prefix",
        "method",
        "expected_media_type",
        "authentication_method_ref",
        "credential_ref",
        "parser_schema_version",
        "redirect_policy",
        "url_query_transmission",
        "cache_permitted",
        "freshness_policy_ref",
        "retry_safe",
        "enabled"
      ],
      "notes": "Immutable per version; replay pins the version used. No credential value."
    },
    {
      "name": "ExternalProviderResponseArtifact",
      "store": "OPS",
      "fields": [
        "response_artifact_ref",
        "response_artifact_digest",
        "provider_ref",
        "provider_policy_version",
        "parser_schema_version",
        "observed_at",
        "normalized_payload",
        "raw_provider_content_policy_ref"
      ],
      "notes": "Immutable record of what TrustLens accepted; digest proves recording integrity, not provider truth or authenticity. Raw provider content is retained in ECS only if a governed raw-content policy permits it."
    },
    {
      "name": "FreshnessMetadata",
      "store": "OPS",
      "fields": [
        "observed_at",
        "freshness_state",
        "freshness_policy_ref",
        "cache_used"
      ],
      "notes": "Technical recency only; never confidence or risk."
    },
    {
      "name": "FailureOutcome",
      "store": "OPS",
      "fields": [
        "lookup_outcome",
        "status",
        "safe_error_category"
      ],
      "notes": "Integration outcome only; never a scam classification."
    },
    {
      "name": "ReplayReference",
      "store": "OPS",
      "fields": [
        "external_enrichment_result_id",
        "response_artifact_digest",
        "provider_policy_version",
        "adapter_version",
        "parser_schema_version"
      ],
      "notes": "Pins the exact retained enrichment material; replay never re-queries."
    }
