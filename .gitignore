# Build output
target/
build/
dist/
out/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Node
node_modules/
.vite/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
