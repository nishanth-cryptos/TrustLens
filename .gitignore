# Environment and secrets — never commit real credentials (MP §18)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Evidence and user-submitted artifacts must never enter version control (MP §21)
/evidence-store/
/uploads/
*.evidence

# IDE / OS
.idea/
.vscode/
.DS_Store

# Logs and local databases
*.log
logs/
*.sqlite
*.db
