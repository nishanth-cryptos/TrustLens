        {
          "_type": "UMLClass",
          "_id": "TL-P0",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "0. TrustLens",
          "stereotype": "process",
          "documentation": "Process 0 — the entire system as one process. Explainable scam detection, evidence preservation and assisted reporting. Rules-as-data decide; AI is never the decision authority. No data stores appear at level 0.",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E1",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "Reporting user",
          "stereotype": "external entity",
          "documentation": "P1 Priya, 34 · P2 Ramesh, 68. Submits suspicious artifacts and receives a verdict, an evidence trace and a report bundle.",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E2",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "Analyst",
          "stereotype": "external entity",
          "documentation": "P3 Anjali. Reviews cases routed past the uncertainty threshold and adjudicates them with recorded rationale.",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E3",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "Administrator",
          "stereotype": "external entity",
          "documentation": "P6. Operates the platform: thresholds, retention class, feature flags, rate limits.",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E4",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "Report recipient",
          "stereotype": "external entity",
          "documentation": "Authority, bank or reporting portal. Receives the bundle only through a user-initiated, access-controlled export (NG-01).",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E5",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "Guidance bodies",
          "stereotype": "external entity",
          "documentation": "I4C · CERT-In · RBI · NPCI · SEBI · DoT. Published material is consumed one way and graded before any rule may cite it.",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E6",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "Knowledge editor",
          "stereotype": "external entity",
          "documentation": "P4 Vikram. Authors versioned rule JSON with graded source references; never touches engine code (ADR-0003).",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E7",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "Knowledge approver",
          "stereotype": "external entity",
          "documentation": "P5 Meera. Gate-keeps publication on diff, impact analysis and regression evidence.",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E8",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "URL & threat-intel providers",
          "stereotype": "external entity",
          "documentation": "Post-MVP. Provider-agnostic reputation adapters; the core path completes with any single provider unavailable.",
          "attributes": [],
          "operations": []
        },
        {
          "_type": "UMLClass",
          "_id": "E9",
          "_parent": {
            "$ref": "TL-MODEL"
          },
          "name": "AI assist provider",
          "stereotype": "external entity",
          "documentation": "Post-MVP, feature-flagged. Non-authoritative: output is schema-validated, labelled model-derived, human-approved.",
          "attributes": [],
          "operations": []
        },
